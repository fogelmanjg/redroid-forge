  "combinaciones": [
    {
      "id": "redroid15-gapps",
      "base": "redroid-15-2025-06-27",
      "gapps": "gapps-sdk35-r09-x86_64",
      "magisk": null,
      "modulos": {
        "gapps": 2
      },
      "soporte": "oficial",
      "validaciones": [
        {
          "hardware": {
            "vendor": "amd",
            "gpu": "Radeon RX 480 (Polaris10)",
            "driver": "radeonsi"
          },
          "fecha": "2026-10-10",
          "forgeVersion": "0.1.0",
          "resultado": "ok",
          "chequeos": [
            {
              "id": "gapps.hashes-verificados",
              "resultado": "ok",
              "detalle": "the 14 files of the package are verified against their sha256 before injecting; a tampered, missing or unlisted extra file stops the injection (covered by tests)"
            },
            {
              "id": "gapps.boot",
              "resultado": "ok",
              "detalle": "boot completed in 18 s; Google Play services, Play Store, Google Services Framework and Partner Setup registered as system apps, no crashes"
            },
            {
              "id": "gapps.login-google",
              "resultado": "ok",
              "detalle": "a real Google account signs in (needs the WebView command line --no-sandbox --single-process, which the module writes after every start)"
            },
            {
              "id": "gapps.actualizacion-play",
              "resultado": "ok",
              "detalle": "Play updates itself from GMS 24.23.35 to 26.37.37 and the Play Store from 41.3.25 to 53.4.34 with no INSTALL_FAILED errors"
            },
            {
              "id": "gapps.android-id",
              "resultado": "ok",
              "detalle": "the Android ID exists from the first check-in, is identical in gservices.db and Checkin.xml, and does not change when signing in"
            }
          ],
          "notas": "Validated on the official image redroid/redroid:15.0.0-latest (host GPU mode off the critical path: guest and host modes both boot). Not validated together with hwenc yet: that is a different combination.",
          "evidencia": "https://github.com/fogelmanjg/redroid-forge/pull/20"
        }
      ],
      "problemasConocidos": [
        {
          "id": "login-requiere-webview-sin-sandbox",
          "descripcion": "Google's sign-in screen crashes inside the container (the sandboxed WebView renderer dies with SIGSYS) unless the WebView runs with --no-sandbox --single-process. The module applies it after every start; it reduces the isolation of that instance's WebView."
        },
        {
          "id": "dispositivo-no-certificado",
          "descripcion": "Google sees the instance as an uncertified device: its Android ID has to be registered at https://www.google.com/android/uncertified within 48 hours of the first boot, or Google blocks GApps access on that instance."
        },
        {
          "id": "actualizaciones-por-instancia",
          "descripcion": "After the first sign-in Play services and the Play Store update themselves (hundreds of MB per instance); the versions that end up running are Google's, not the ones in this package."
        }
      ]
    },
    {
      "id": "redroid15-hwenc",
      "base": "redroid-15-2025-06-27",
      "gapps": null,
      "magisk": null,
      "modulos": {
        "hwenc": 4
      },
      "soporte": "oficial",
      "validaciones": [
        {
          "hardware": {
            "vendor": "amd",
            "gpu": "Radeon RX 480 (Polaris10)",
            "driver": "radeonsi"
          },
          "fecha": "2026-10-06",
          "forgeVersion": "0.1.0",
          "resultado": "ok",
          "chequeos": [
            {
              "id": "doctor",
              "resultado": "ok",
              "detalle": "binder legacy slots 1-2, VA-API daemon with radeonsi"
            },
            {
              "id": "hwenc.encoder-registrado",
              "resultado": "ok",
              "detalle": "c2.hardware.encoder.h264 listed in dumpsys media.player"
            },
            {
              "id": "hwenc.screenrecord-frames",
              "resultado": "ok",
              "detalle": "74 H.264 frames in 5 s, correct picture"
            },
            {
              "id": "hwenc.decoders-registrados",
              "resultado": "ok",
              "detalle": "c2.hardware.decoder.h264 and .hevc registered (the daemon reports only what the GPU decodes); VP9 is not registered"
            },
            {
              "id": "hwenc.decode-h264",
              "resultado": "ok",
              "detalle": "H.264 High with B-frames, 720p (300 frames) and 1080p (180): identical to ffmpeg through MediaCodec; 0.64 s of CPU per 100 frames against 2.44 s for the software decoder"
            },
            {
              "id": "hwenc.decode-hevc",
              "resultado": "ok",
              "detalle": "HEVC 1080p, 180 frames identical to ffmpeg; 0.72 s of CPU per 100 frames against 2.14 s for software"
            },
            {
              "id": "hwenc.decode-hevc-10bit",
              "resultado": "ok",
              "detalle": "HEVC Main10 1080p, 150 frames identical to ffmpeg with 8-bit output (the high 8 bits); there is no real HDR"
            },
            {
              "id": "hwenc.decode-vp9",
              "resultado": "omitido",
              "detalle": "the GPU (UVD/VCE) does not decode VP9 in hardware: Android uses its software decoder"
            },
            {
              "id": "hwenc.scrcpy-visual",
              "resultado": "ok",
              "detalle": "SmartTube 1080p60 AVC 7.7 Mbps watched through scrcpy between two cities and two ISPs: flawless quality, very slight stutter, 0 frames dropped by the player"
            }
          ],
          "notas": "Hardware decode of H.264 and HEVC (8 and 10 bits) verified bit by bit against ffmpeg. The encode checks are inherited from the validation of module v3 (the encoder did not change). In real use with SmartTube 1080p60 and scrcpy there were two intermittent VCE hangs (ring vce0 timeout, GPU reset) in ~16 min: see problemasConocidos.",
          "evidencia": "https://github.com/fogelmanjg/redroid-forge/pull/15"
        },
        {
          "hardware": {
            "vendor": "intel",
            "gpu": "Iris Xe (TigerLake-LP GT2)",
            "driver": "iHD"
          },
          "fecha": "2026-10-07",
          "forgeVersion": "0.1.0",
          "resultado": "ok",
          "chequeos": [
            {
              "id": "doctor",
              "resultado": "ok",
              "detalle": "binder legacy slot 0 (devices= by default), VA-API daemon with iHD, Y_TILED modifier"
            },
            {
              "id": "hwenc.encoder-registrado",
              "resultado": "ok",
              "detalle": "c2.hardware.encoder.h264 listed in dumpsys media.player"
            },
            {
              "id": "hwenc.screenrecord-frames",
              "resultado": "ok",
              "detalle": "209 H.264 Constrained Baseline 1000x600 frames in a valid MP4; the daemon logged 209 encodes"
            },
            {
              "id": "hwenc.scrcpy-visual",
              "resultado": "ok",
              "detalle": "watched live through scrcpy, clean and smooth picture"
            },
            {
              "id": "hwenc.decoders-registrados",
              "resultado": "ok",
              "detalle": "c2.hardware.decoder.h264, .hevc and .vp9 registered (iHD also decodes vp8, mpeg2, vc1 and av1, for which there is no component yet)"
            },
            {
              "id": "hwenc.decode-h264",
              "resultado": "ok",
              "detalle": "720p (300 frames) and 1080p (180): identical to ffmpeg; 1.99 s of CPU per 100 frames against 5.32 s for software (2.7x less)"
            },
            {
              "id": "hwenc.decode-hevc",
              "resultado": "ok",
              "detalle": "HEVC 1080p, 180 identical frames; 1.80 s per 100 frames against 4.87 s (2.7x less)"
            },
            {
              "id": "hwenc.decode-hevc-10bit",
              "resultado": "ok",
              "detalle": "HEVC Main10 1080p, 150 identical frames with 8-bit output"
            },
            {
              "id": "hwenc.decode-vp9",
              "resultado": "ok",
              "detalle": "VP9 720p (240 frames) identical; 1080p: 1.72 s per 100 frames against 2.46 s for software (only 1.4x less)"
            },
            {
              "id": "hwenc.decode-vp9-10bit",
              "resultado": "ok",
              "detalle": "VP9 profile 2 720p, 150 identical frames with 8-bit output"
            }
          ],
          "notas": "It required two Intel-specific fixes: intel-media-driver in the backend image and normalization of Annex-B start codes to 4 bytes in the daemon (iHD emits 3 and MPEG4Writer's CSD parser requires 4). 1000x600 instance with a 3 GB cap, real use ~1.6 GB. Hardware decode verified on the same machine on 07/10/2026 (laptop CPU). The direct download through vaDeriveImage passed the self-check on Intel. The CPU saving with VP9 is modest because the software decoder is very efficient.",
          "evidencia": "https://github.com/fogelmanjg/redroid-forge/pull/15"
        }
      ],
      "problemasConocidos": [
        {
          "id": "polaris-vce-timeout-intermitente",
          "hardware": {
            "vendor": "amd",
            "gpu": "Radeon RX 480 (Polaris10)"
          },
          "descripcion": "With decode and encode (scrcpy) at the same time at 1080p60, a VCE timeout (ring vce0 timeout) that resets the GPU and restarts Android was seen twice in ~16 min. The daemon relaunches by itself. Not reproduced with decode only; suspected causes are the VCE waking up after being idle, or the old driver/VA-API of that generation."
        },
        {
          "id": "encoder-sin-control-de-bitrate",
          "descripcion": "The encoder uses a fixed QP and does not respect the bitrate scrcpy asks for: at 720p60 it produces ~50 Mbps. It works, but uses a lot of upload on remote connections. Improvement pending."
        },
        {
          "id": "hdr-y-10-bits-salen-como-8-bits",
          "descripcion": "10-bit video (HDR) is decoded in hardware but comes out as 8-bit: redroid's gralloc restarts Android when allocating P010 buffers. There is no real HDR, not even through scrcpy."
        }
      ]
    }
  ]
}

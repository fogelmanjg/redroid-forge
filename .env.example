# Copy this file to .env and adjust before `docker compose up`. Every var here has a safe
# default (see docker-compose.yml) -- this file only exists to make them discoverable without
# having to go read the compose file first, and to flag the two that matter most on a host that
# already runs another instance of this app (see README.md's "Starting the app" section).

# The single most common reason the container starts but the app is unreachable: another
# process on this host is already using the default 8080. Check `ss -tlnp | grep :8080` (or
# whatever you set here) before starting if you are not sure.
PORT=8080

# Only needed on a host that already runs another checkout of this project -- container names
# must be unique on a host, and every checkout defaults to the same "redroid-forge".
#CONTAINER_NAME=redroid-forge

# Range of host ports handed out for instances' ADB access (one per running instance).
#ADB_PORT_START=5555
#ADB_PORT_END=5595

# Bind the app itself to a specific interface instead of localhost-only (see README.md's
# "Network exposure control"). Leave unset unless you specifically need this.
#REDROID_FORGE_BIND_HOST=127.0.0.1

# 1 = build the hwdec module's own daemon (hardware video decode); 0 = skip it. See the
# Dockerfile and docs/ARCHITECTURE.md.
#HWDEC=1

# Access control: none (default, no login) / local (built-in accounts) / oidc / both. See
# README.md's "Access control" feature row and docs/REQUIREMENTS.md section 5.
#REDROID_FORGE_AUTH=none
#REDROID_FORGE_LOCAL_ADMIN_USER=
#REDROID_FORGE_LOCAL_ADMIN_PASSWORD=
#REDROID_FORGE_OIDC_PROVIDERS=
#REDROID_FORGE_OIDC_REDIRECT_BASE_URL=
#REDROID_FORGE_OIDC_BOOTSTRAP_ADMIN_ID=

# Encoder P-frames (backend/native/vaapi-daemon/daemon.c) -- off (all-intra) unless set to an
# integer > 1 (frames per IDR).
#REDROID_FORGE_ENCODE_IDR_PERIOD=1

# Host paths for optional, not-bundled modules -- see each one's integrate.js for what it's for.
# Empty/unset means that module's host infra is simply not available yet, not an error.
#REDROID_HWENC_ARTIFACTS_DIR=
#REDROID_NVENC_ARTIFACTS_DIR=
#REDROID_VENUS3D_ARTIFACTS_DIR=
#REDROID_FORGE_VIRTWIFI_KO_PATH=

# Absolute HOST paths (not container-internal) -- see docker-compose.yml's own comments on why,
# right above where these are bind-mounted. Default to this checkout's backend/data/ subfolders.
#REDROID_FORGE_BACKUPS_DIR=${PWD}/backend/data/backups
#REDROID_FORGE_MEMINFO_FIX_DIR=${PWD}/backend/data/meminfo-fix
